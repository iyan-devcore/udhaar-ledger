# Copy to .env.local (development) or .env (production) and fill in.

# Login password. In production use a hash made with:
#   npm run hash-password -- "your password"
APP_PASSWORD_HASH=
# For local development only, you can set a plain password instead:
# APP_PASSWORD=change-me

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Where the SQLite database and nightly backups live (use a persistent disk).
DATABASE_PATH=./data/ledger.db
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# Time zone for "today", due dates and backup names.
APP_TIMEZONE=Asia/Kolkata

# Public address of the app, used for /pay links inside WhatsApp reminders.
# Example: https://udhar.example.com
PUBLIC_BASE_URL=

# ---- Phase 2 (not used yet; v1 makes no external API calls) ----
# WhatsApp Cloud API
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=payment_reminder
# REMINDER_DAYS_BEFORE=2
# Razorpay payment links + webhook
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
